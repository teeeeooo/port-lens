{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Port Lens",
  "version": "0.3.2",
  "identifier": "io.github.teeeeooo.portlens",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Port Lens",
        "width": 1020,
        "height": 680,
        "minWidth": 800,
        "minHeight": 580,
        "center": true,
        "transparent": true
      },
      {
        "label": "compact-hover",
        "title": "Port Lens Apps",
        "url": "index.html?compactHover=1",
        "width": 276,
        "height": 240,
        "resizable": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "parent": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
